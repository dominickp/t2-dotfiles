# aliases.zsh
# Shell aliases. Source this from your ~/.zshrc — see README.md.

# ── Shell ────────────────────────────────────────────────────────────────

# Reload the shell configuration.
alias reload='source ~/.zshrc'

# Alternative: fully restart the shell (also re-runs zshenv/zprofile).
# alias reload='exec zsh'

# ── Handy defaults ───────────────────────────────────────────────────────

alias ll='ls -lah'
alias ..='cd ..'
